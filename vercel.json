{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/ifood/(.*)", "destination": "/api/index" },
    { "source": "/api/health",      "destination": "/api/index" },
    { "source": "/api/session",     "destination": "/api/index" },
    { "source": "/api/notifications/(.*)", "destination": "/api/index" },
    { "source": "/api/data/upload", "destination": "/api/index" },
    { "source": "/api/data",        "destination": "/api/index" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
