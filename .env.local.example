# Copie este arquivo para .env.local e nunca publique valores reais.

# Perfis do portal: gere um SHA-256 diferente para cada senha.
ADMIN_PASSWORD_HASH=
FRANCHISE_PASSWORD_HASH=
FRANCHISE_POTENTIAL_PASSWORD_HASH=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Integração iFood
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_AUTH_MODE=oauth
IFOOD_TOKEN=
IFOOD_TEST_MERCHANT_ID=

NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# Avisos por e-mail (opcional)
DASHBOARD_PUBLIC_URL=https://italinhouse-ip.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_BATCH_SIZE=50
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# WhatsApp Cloud API (opcional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Feedback dos franqueados (opcional)
# URL pública do Google Form exibida aos franqueados.
VITE_FEEDBACK_FORM_URL=
# URL CSV da planilha de respostas. Manter como variável Sensitive na Vercel.
FEEDBACK_SHEET_CSV_URL=
